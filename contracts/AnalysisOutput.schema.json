{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hark://contracts/AnalysisOutput.json",
  "$defs": {
    "ExtractedTask": {
      "properties": {
        "title": {
          "default": "",
          "title": "Title",
          "type": "string"
        },
        "assignee": {
          "default": "",
          "title": "Assignee",
          "type": "string"
        },
        "due": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "ISO date YYYY-MM-DD, only if said.",
          "title": "Due"
        },
        "confidence": {
          "default": 0.5,
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "evidence_timestamp": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Timestamp of the source line: 'mm:ss' or seconds.",
          "title": "Evidence Timestamp"
        }
      },
      "title": "ExtractedTask",
      "type": "object"
    }
  },
  "description": "Structured output requested from the LLM (validated by this schema).",
  "properties": {
    "title": {
      "default": "",
      "title": "Title",
      "type": "string"
    },
    "summary": {
      "default": "",
      "title": "Summary",
      "type": "string"
    },
    "decisions": {
      "items": {
        "type": "string"
      },
      "title": "Decisions",
      "type": "array"
    },
    "tasks": {
      "items": {
        "$ref": "#/$defs/ExtractedTask"
      },
      "title": "Tasks",
      "type": "array"
    },
    "open_questions": {
      "items": {
        "type": "string"
      },
      "title": "Open Questions",
      "type": "array"
    }
  },
  "title": "AnalysisOutput",
  "type": "object"
}
