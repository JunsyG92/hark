{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hark://contracts/EvidenceRef.json",
  "additionalProperties": false,
  "description": "Pointer to the timestamped transcript excerpt a task comes from.",
  "properties": {
    "meeting_id": {
      "maxLength": 64,
      "minLength": 1,
      "title": "Meeting Id",
      "type": "string"
    },
    "start_ms": {
      "minimum": 0,
      "title": "Start Ms",
      "type": "integer"
    },
    "end_ms": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "End Ms"
    }
  },
  "required": [
    "meeting_id",
    "start_ms",
    "end_ms"
  ],
  "title": "EvidenceRef",
  "type": "object"
}
