{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hark://contracts/UserProfile.json",
  "additionalProperties": false,
  "description": "The user's profile (profile.yaml): used to flag the tasks that concern them.",
  "properties": {
    "name": {
      "default": "",
      "maxLength": 200,
      "title": "Name",
      "type": "string"
    },
    "email": {
      "default": "",
      "maxLength": 200,
      "title": "Email",
      "type": "string"
    },
    "nicknames": {
      "items": {
        "maxLength": 50,
        "type": "string"
      },
      "maxItems": 20,
      "title": "Nicknames",
      "type": "array"
    },
    "role": {
      "default": "",
      "maxLength": 200,
      "title": "Role",
      "type": "string"
    },
    "team": {
      "default": "",
      "maxLength": 200,
      "title": "Team",
      "type": "string"
    },
    "projects": {
      "items": {
        "maxLength": 100,
        "type": "string"
      },
      "maxItems": 50,
      "title": "Projects",
      "type": "array"
    },
    "keywords": {
      "items": {
        "maxLength": 100,
        "type": "string"
      },
      "maxItems": 50,
      "title": "Keywords",
      "type": "array"
    }
  },
  "required": [
    "name",
    "email",
    "nicknames",
    "role",
    "team",
    "projects",
    "keywords"
  ],
  "title": "UserProfile",
  "type": "object"
}
