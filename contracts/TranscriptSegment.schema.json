{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hark://contracts/TranscriptSegment.json",
  "$defs": {
    "Speaker": {
      "enum": [
        "me",
        "others"
      ],
      "title": "Speaker",
      "type": "string"
    },
    "TrackKind": {
      "enum": [
        "system",
        "mic"
      ],
      "title": "TrackKind",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "id": {
      "title": "Id",
      "type": "integer"
    },
    "meeting_id": {
      "title": "Meeting Id",
      "type": "string"
    },
    "track": {
      "$ref": "#/$defs/TrackKind"
    },
    "speaker": {
      "$ref": "#/$defs/Speaker"
    },
    "start_ms": {
      "minimum": 0,
      "title": "Start Ms",
      "type": "integer"
    },
    "end_ms": {
      "minimum": 0,
      "title": "End Ms",
      "type": "integer"
    },
    "text": {
      "title": "Text",
      "type": "string"
    }
  },
  "required": [
    "id",
    "meeting_id",
    "track",
    "speaker",
    "start_ms",
    "end_ms",
    "text"
  ],
  "title": "TranscriptSegment",
  "type": "object"
}
