  "components": {
    "schemas": {
      "Column": {
        "type": "string",
        "enum": [
          "to_validate",
          "todo",
          "in_progress",
          "done"
        ],
        "title": "Column"
      },
      "DetectionPhase": {
        "type": "string",
        "enum": [
          "disabled",
          "idle",
          "prompted",
          "cooldown",
          "recording"
        ],
        "title": "DetectionPhase"
      },
      "DetectionSettings": {
        "properties": {
          "enabled": {
            "type": "boolean",
            "title": "Enabled",
            "default": true
          },
          "threshold_db": {
            "type": "number",
            "maximum": -10.0,
            "minimum": -80.0,
            "title": "Threshold Db",
            "description": "RMS dBFS.",
            "default": -45.0
          },
          "min_seconds": {
            "type": "number",
            "maximum": 120.0,
            "minimum": 1.0,
            "title": "Min Seconds",
            "default": 8.0
          },
          "require_mic_in_use": {
            "type": "boolean",
            "title": "Require Mic In Use",
            "description": "Another app must be using the microphone (call signal).",
            "default": true
          },
          "prompt_seconds": {
            "type": "number",
            "maximum": 120.0,
            "minimum": 5.0,
            "title": "Prompt Seconds",
            "default": 20.0
          },
          "cooldown_ignore_minutes": {
            "type": "number",
            "maximum": 240.0,
            "minimum": 0.0,
            "title": "Cooldown Ignore Minutes",
            "default": 10.0
          },
          "cooldown_decline_minutes": {
            "type": "number",
            "maximum": 240.0,
            "minimum": 0.0,
            "title": "Cooldown Decline Minutes",
            "default": 30.0
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "enabled",
          "threshold_db",
          "min_seconds",
          "require_mic_in_use",
          "prompt_seconds",
          "cooldown_ignore_minutes",
          "cooldown_decline_minutes"
        ],
        "title": "DetectionSettings",
        "description": "Meeting detection tuning. Detection only observes audio levels; nothing is recorded."
      },
      "DetectionSettingsPatch": {
        "properties": {
          "enabled": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Enabled"
          },
          "threshold_db": {
            "anyOf": [
              {
                "type": "number",
                "maximum": -10.0,
                "minimum": -80.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Threshold Db"
          },
          "min_seconds": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 120.0,
                "minimum": 1.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Min Seconds"
          },
          "require_mic_in_use": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Require Mic In Use"
          },
          "prompt_seconds": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 120.0,
                "minimum": 5.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Prompt Seconds"
          },
          "cooldown_ignore_minutes": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 240.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Cooldown Ignore Minutes"
          },
          "cooldown_decline_minutes": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 240.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Cooldown Decline Minutes"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "DetectionSettingsPatch"
      },
      "DetectionStatus": {
        "properties": {
          "phase": {
            "$ref": "#/components/schemas/DetectionPhase"
          },
          "level_db": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Level Db",
            "description": "Current output level, null if no audio source."
          },
          "above_threshold_seconds": {
            "type": "number",
            "title": "Above Threshold Seconds"
          },
          "mic_in_use": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Mic In Use",
            "description": "null when the OS does not expose it."
          },
          "mic_apps": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Mic Apps"
          },
          "audio_source": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Audio Source"
          },
          "error": {
